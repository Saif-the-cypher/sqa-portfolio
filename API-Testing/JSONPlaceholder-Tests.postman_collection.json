{
  "info": {
    "_postman_id": "78ddf479-1cec-4e32-9fb8-fcd6f8fc2851",
    "name": "JSONPlaceholder Tests",
    "description": "API practice collection for the SQA roadmap (Days 11-12). Uses the public fake API https://jsonplaceholder.typicode.com and httpbin.org/bearer. Select the 'JSONPlaceholder' environment before running.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Posts",
      "item": [
        {
          "name": "GET single post",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const body = pm.response.json();",
                  "",
                  "pm.test(\"Status code is 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test(\"Response time is under 2000 ms\", function () {",
                  "    pm.expect(pm.response.responseTime).to.be.below(2000);",
                  "});",
                  "",
                  "pm.test(\"Content-Type is JSON\", function () {",
                  "    pm.expect(pm.response.headers.get(\"Content-Type\")).to.include(\"application/json\");",
                  "});",
                  "",
                  "pm.test(\"Post id is 1\", function () {",
                  "    pm.expect(body.id).to.eql(1);",
                  "});",
                  "",
                  "pm.test(\"Required fields are present\", function () {",
                  "    pm.expect(body).to.have.property(\"userId\");",
                  "    pm.expect(body).to.have.property(\"id\");",
                  "    pm.expect(body).to.have.property(\"title\");",
                  "    pm.expect(body).to.have.property(\"body\");",
                  "});",
                  "",
                  "pm.test(\"Data types are correct\", function () {",
                  "    pm.expect(body.userId).to.be.a(\"number\");",
                  "    pm.expect(body.id).to.be.a(\"number\");",
                  "    pm.expect(body.title).to.be.a(\"string\");",
                  "    pm.expect(body.title).to.not.be.empty;",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/posts/1",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "posts",
                "1"
              ]
            }
          }
        },
        {
          "name": "GET posts by user",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const posts = pm.response.json();",
                  "",
                  "pm.test(\"Status code is 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test(\"Response time is under 2000 ms\", function () {",
                  "    pm.expect(pm.response.responseTime).to.be.below(2000);",
                  "});",
                  "",
                  "pm.test(\"Content-Type is JSON\", function () {",
                  "    pm.expect(pm.response.headers.get(\"Content-Type\")).to.include(\"application/json\");",
                  "});",
                  "",
                  "pm.test(\"Response is a non-empty array\", function () {",
                  "    pm.expect(posts).to.be.an(\"array\");",
                  "    pm.expect(posts).to.not.be.empty;",
                  "});",
                  "",
                  "pm.test(\"Exactly 10 posts are returned for user 7\", function () {",
                  "    pm.expect(posts).to.have.lengthOf(10);",
                  "});",
                  "",
                  "pm.test(\"Every post belongs to userId 7\", function () {",
                  "    posts.forEach(function (post) {",
                  "        pm.expect(post.userId).to.eql(7);",
                  "    });",
                  "});",
                  "",
                  "pm.test(\"Every post has all required fields\", function () {",
                  "    posts.forEach(function (post) {",
                  "        pm.expect(post).to.have.property(\"userId\");",
                  "        pm.expect(post).to.have.property(\"id\");",
                  "        pm.expect(post).to.have.property(\"title\");",
                  "        pm.expect(post).to.have.property(\"body\");",
                  "    });",
                  "});",
                  "",
                  "pm.test(\"Data types are correct for every post\", function () {",
                  "    posts.forEach(function (post) {",
                  "        pm.expect(post.userId).to.be.a(\"number\");",
                  "        pm.expect(post.id).to.be.a(\"number\");",
                  "        pm.expect(post.title).to.be.a(\"string\");",
                  "        pm.expect(post.body).to.be.a(\"string\");",
                  "    });",
                  "});",
                  "",
                  "pm.test(\"All post ids are unique\", function () {",
                  "    const ids = posts.map(function (post) { return post.id; });",
                  "    pm.expect(new Set(ids).size).to.eql(ids.length);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/posts?userId=7",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "posts"
              ],
              "query": [
                {
                  "key": "userId",
                  "value": "7"
                }
              ]
            }
          }
        },
        {
          "name": "POST create post",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const res = pm.response.json();",
                  "const sent = JSON.parse(pm.request.body.raw);",
                  "",
                  "pm.test(\"Status code is 201 Created\", function () {",
                  "    pm.response.to.have.status(201);",
                  "});",
                  "",
                  "pm.test(\"Response time is under 2000 ms\", function () {",
                  "    pm.expect(pm.response.responseTime).to.be.below(2000);",
                  "});",
                  "",
                  "pm.test(\"Content-Type is JSON\", function () {",
                  "    pm.expect(pm.response.headers.get(\"Content-Type\")).to.include(\"application/json\");",
                  "});",
                  "",
                  "pm.test(\"A new id was generated\", function () {",
                  "    pm.expect(res).to.have.property(\"id\");",
                  "    pm.expect(res.id).to.be.a(\"number\");",
                  "    pm.expect(res.id).to.eql(101);",
                  "});",
                  "",
                  "pm.test(\"Response data matches the request body\", function () {",
                  "    pm.expect(res.title).to.eql(sent.title);",
                  "    pm.expect(res.body).to.eql(sent.body);",
                  "    pm.expect(res.userId).to.eql(sent.userId);",
                  "});",
                  "",
                  "pm.test(\"Data types are correct\", function () {",
                  "    pm.expect(res.title).to.be.a(\"string\");",
                  "    pm.expect(res.body).to.be.a(\"string\");",
                  "    pm.expect(res.userId).to.be.a(\"number\");",
                  "});",
                  "",
                  "pm.environment.set(\"newPostId\", res.id);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/posts",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "posts"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Bill pay validation\",\n  \"body\": \"Testing the create endpoint\",\n  \"userId\": 1\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "PUT update post",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const res = pm.response.json();",
                  "const sent = JSON.parse(pm.request.body.raw);",
                  "",
                  "pm.test(\"Status code is 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test(\"Response time is under 2000 ms\", function () {",
                  "    pm.expect(pm.response.responseTime).to.be.below(2000);",
                  "});",
                  "",
                  "pm.test(\"Content-Type is JSON\", function () {",
                  "    pm.expect(pm.response.headers.get(\"Content-Type\")).to.include(\"application/json\");",
                  "});",
                  "",
                  "pm.test(\"The id is still 1 (record was updated, not created)\", function () {",
                  "    pm.expect(res.id).to.eql(1);",
                  "});",
                  "",
                  "pm.test(\"All fields match the updated values\", function () {",
                  "    pm.expect(res.title).to.eql(sent.title);",
                  "    pm.expect(res.body).to.eql(sent.body);",
                  "    pm.expect(res.userId).to.eql(sent.userId);",
                  "});",
                  "",
                  "pm.test(\"All required fields are present\", function () {",
                  "    pm.expect(res).to.have.all.keys(\"id\", \"title\", \"body\", \"userId\");",
                  "});",
                  "",
                  "pm.test(\"Data types are correct\", function () {",
                  "    pm.expect(res.id).to.be.a(\"number\");",
                  "    pm.expect(res.userId).to.be.a(\"number\");",
                  "    pm.expect(res.title).to.be.a(\"string\");",
                  "    pm.expect(res.body).to.be.a(\"string\");",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/posts/1",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "posts",
                "1"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"id\": 1,\n  \"title\": \"Updated title\",\n  \"body\": \"Updated body\",\n  \"userId\": 1\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "PATCH update post",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const res = pm.response.json();",
                  "const sent = JSON.parse(pm.request.body.raw);",
                  "",
                  "pm.test(\"Status code is 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test(\"Response time is under 2000 ms\", function () {",
                  "    pm.expect(pm.response.responseTime).to.be.below(2000);",
                  "});",
                  "",
                  "pm.test(\"Content-Type is JSON\", function () {",
                  "    pm.expect(pm.response.headers.get(\"Content-Type\")).to.include(\"application/json\");",
                  "});",
                  "",
                  "pm.test(\"The id is still 1\", function () {",
                  "    pm.expect(res.id).to.eql(1);",
                  "});",
                  "",
                  "pm.test(\"Only the sent field was changed\", function () {",
                  "    pm.expect(res.title).to.eql(sent.title);",
                  "});",
                  "",
                  "pm.test(\"Fields that were not sent are still present\", function () {",
                  "    pm.expect(res).to.have.property(\"body\");",
                  "    pm.expect(res).to.have.property(\"userId\");",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/posts/1",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "posts",
                "1"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Only the title changed\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "DELETE post",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status code is 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test(\"Response time is under 2000 ms\", function () {",
                  "    pm.expect(pm.response.responseTime).to.be.below(2000);",
                  "});",
                  "",
                  "pm.test(\"Content-Type is JSON\", function () {",
                  "    pm.expect(pm.response.headers.get(\"Content-Type\")).to.include(\"application/json\");",
                  "});",
                  "",
                  "pm.test(\"Response body is an empty object\", function () {",
                  "    const res = pm.response.json();",
                  "    pm.expect(res).to.be.an(\"object\");",
                  "    pm.expect(Object.keys(res)).to.have.lengthOf(0);",
                  "});",
                  "",
                  "pm.test(\"Deleted post data is not echoed back\", function () {",
                  "    const res = pm.response.json();",
                  "    pm.expect(res).to.not.have.property(\"title\");",
                  "    pm.expect(res).to.not.have.property(\"body\");",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/posts/1",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "posts",
                "1"
              ]
            }
          }
        },
        {
          "name": "GET non-existent post",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status code is 404\", function () {",
                  "    pm.response.to.have.status(404);",
                  "});",
                  "",
                  "pm.test(\"Response time is under 2000 ms\", function () {",
                  "    pm.expect(pm.response.responseTime).to.be.below(2000);",
                  "});",
                  "",
                  "pm.test(\"Response body is an empty object\", function () {",
                  "    pm.expect(Object.keys(pm.response.json())).to.have.lengthOf(0);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/posts/9999",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "posts",
                "9999"
              ]
            }
          }
        }
      ]
    },
    {
      "name": "Authentication",
      "item": [
        {
          "name": "GET bearer - with token",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const res = pm.response.json();",
                  "",
                  "pm.test(\"Status code is 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test(\"Response time is under 2000 ms\", function () {",
                  "    pm.expect(pm.response.responseTime).to.be.below(2000);",
                  "});",
                  "",
                  "pm.test(\"Content-Type is JSON\", function () {",
                  "    pm.expect(pm.response.headers.get(\"Content-Type\")).to.include(\"application/json\");",
                  "});",
                  "",
                  "pm.test(\"User is authenticated\", function () {",
                  "    pm.expect(res).to.have.property(\"authenticated\");",
                  "    pm.expect(res.authenticated).to.eql(true);",
                  "});",
                  "",
                  "pm.test(\"Returned token matches the token we sent\", function () {",
                  "    pm.expect(res.token).to.eql(pm.environment.get(\"token\"));",
                  "});",
                  "",
                  "pm.test(\"Data types are correct\", function () {",
                  "    pm.expect(res.authenticated).to.be.a(\"boolean\");",
                  "    pm.expect(res.token).to.be.a(\"string\");",
                  "    pm.expect(res.token).to.not.be.empty;",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{BearertokenURL}}",
              "host": [
                "{{BearertokenURL}}"
              ]
            },
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{token}}",
                  "type": "string"
                }
              ]
            }
          }
        },
        {
          "name": "GET bearer - no token",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status code is 401 Unauthorized\", function () {",
                  "    pm.response.to.have.status(401);",
                  "});",
                  "",
                  "pm.test(\"Response time is under 2000 ms\", function () {",
                  "    pm.expect(pm.response.responseTime).to.be.below(2000);",
                  "});",
                  "",
                  "pm.test(\"Request was rejected, not authenticated\", function () {",
                  "    pm.expect(pm.response.code).to.not.eql(200);",
                  "});",
                  "",
                  "pm.test(\"Server asks for Bearer authentication\", function () {",
                  "    pm.expect(pm.response.headers.get(\"WWW-Authenticate\")).to.include(\"Bearer\");",
                  "});",
                  "",
                  "pm.test(\"No token or user data is leaked in the body\", function () {",
                  "    pm.expect(pm.response.text()).to.not.include(\"abc123\");",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{BearertokenURL}}",
              "host": [
                "{{BearertokenURL}}"
              ]
            },
            "auth": {
              "type": "noauth"
            }
          }
        }
      ]
    }
  ]
}